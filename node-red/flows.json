[
  {
    "id": "station",
    "type": "tab",
    "label": "GridSense required IoT loop",
    "disabled": false,
    "info": "ev/telemetry splits immediately: A live Dashboard; B SQLite commit -> DB-only analytics/evaluation -> decision -> ev/actuator. ev/ack records control performance."
  },
  {
    "id": "broker",
    "type": "mqtt-broker",
    "name": "Project laptop MQTT broker (Aedes)",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "gridsense_nodered",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "sensor",
    "type": "mqtt in",
    "z": "station",
    "name": "Station telemetry",
    "topic": "ev/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "broker",
    "x": 150,
    "y": 100,
    "wires": [
      [
        "live-filter",
        "request"
      ]
    ]
  },
  {
    "id": "request",
    "type": "function",
    "z": "station",
    "name": "Path B: SQLite storage adapter",
    "func": "msg.headers = {'content-type':'application/json'};\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 100,
    "wires": [
      [
        "analytics"
      ]
    ]
  },
  {
    "id": "analytics",
    "type": "http request",
    "z": "station",
    "name": "Commit telemetry/history to SQLite",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://127.0.0.1:8765/store",
    "persist": false,
    "senderr": false,
    "x": 700,
    "y": 100,
    "wires": [
      [
        "stored"
      ]
    ]
  },
  {
    "id": "route",
    "type": "function",
    "z": "station",
    "name": "Validate service response",
    "func": "if(msg.statusCode !== 200 || !msg.payload.decision) {node.error('Decision failed',msg);return null;} return [msg,msg];",
    "outputs": 2,
    "x": 980,
    "y": 100,
    "wires": [
      [
        "dashboard",
        "alerts-panel"
      ],
      [
        "command"
      ]
    ]
  },
  {
    "id": "command",
    "type": "function",
    "z": "station",
    "name": "Publish whole-station decision",
    "func": "msg.payload = JSON.stringify(msg.payload.decision); return msg;",
    "outputs": 1,
    "x": 990,
    "y": 220,
    "wires": [
      [
        "actuator"
      ]
    ]
  },
  {
    "id": "actuator",
    "type": "mqtt out",
    "z": "station",
    "name": "Actuator command",
    "topic": "ev/actuator",
    "qos": "1",
    "retain": "false",
    "broker": "broker",
    "x": 1260,
    "y": 220,
    "wires": []
  },
  {
    "id": "ack",
    "type": "mqtt in",
    "z": "station",
    "name": "Actuator acknowledgement",
    "topic": "ev/ack",
    "qos": "1",
    "datatype": "json",
    "broker": "broker",
    "x": 180,
    "y": 320,
    "wires": [
      [
        "debug",
        "ack-store"
      ]
    ]
  },
  {
    "id": "errors",
    "type": "catch",
    "z": "station",
    "name": "Flow errors",
    "scope": null,
    "uncaught": false,
    "x": 170,
    "y": 400,
    "wires": [
      [
        "debug"
      ]
    ]
  },
  {
    "id": "debug",
    "type": "debug",
    "z": "station",
    "name": "Acknowledgements / errors",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 510,
    "y": 340,
    "wires": []
  },
  {
    "id": "dashboard",
    "type": "ui-template",
    "z": "station",
    "group": "ml-group",
    "name": "Five-model evaluation",
    "order": 1,
    "width": "12",
    "height": "0",
    "templateScope": "local",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "x": 690,
    "y": 40,
    "wires": [
      []
    ],
    "format": "<template>\n  <section class=\"gs-ml\" v-if=\"msg?.payload?.decision\">\n    <div class=\"gs-section-heading\"><div><p class=\"gs-eyebrow\">PREDICTION & PERFORMANCE</p><h2>Intelligence behind each decision</h2></div><span class=\"gs-pill good\">{{ Object.keys(msg.payload.decision.performance.models).length }} models evaluated</span></div>\n    <p>Training data: {{ msg.payload.decision.performance.data_source || 'unreported legacy source' }}</p>\n    <div class=\"gs-model-summary\">\n      <div><span>Selected model</span><strong>{{ modelName(msg.payload.decision.model) }}</strong></div>\n      <div><span>Next-hour energy forecast</span><strong>{{ forecast }}</strong></div>\n      <div><span>Prediction time</span><strong>{{ fmt(msg.payload.decision.inference_ms, 3) }} <small>ms</small></strong></div>\n    </div>\n    <div style=\"overflow-x:auto\">\n      <table>\n        <thead><tr><th>Model</th><th>Accuracy</th><th>RMSE (kWh)</th><th>MAE (kWh)</th><th>R²</th><th>p95 inference (ms)</th></tr></thead>\n        <tbody><tr v-for=\"(m, name) in msg.payload.decision.performance.models\" :key=\"name\"\n          :class=\"{selected: name === msg.payload.decision.model}\">\n          <td><strong>{{ modelName(name) }}</strong> <span v-if=\"name === msg.payload.decision.model\" class=\"gs-model-winner\">SELECTED</span></td>\n          <td>{{ fmt(m.test.accuracy * 100, 1) }}%</td><td>{{ fmt(m.test.rmse_kwh) }}</td>\n          <td>{{ fmt(m.test.mae_kwh) }}</td><td>{{ fmt(m.test.r2, 3) }}</td>\n          <td>{{ fmt(m.computational.inference_p95_ms, 3) }}</td>\n        </tr></tbody>\n      </table>\n    </div>\n    <p v-if=\"!Object.keys(msg.payload.decision.performance.models).length\">Train models to populate this table.</p>\n    <p class=\"gs-ml-note\">Selected by validation error, with a 100 ms p95 latency limit. Lower RMSE and MAE are better; higher R² and accuracy are better.</p>\n    <details><summary>How to read these metrics</summary><p>Accuracy measures the companion high-demand classifier (energy ≥30 kWh). RMSE, MAE and R² measure the energy regressor. Test scores use held-out days from {{ msg.payload.decision.performance.data_source || 'unreported legacy source' }}. The selected model must beat the constant baseline on validation RMSE.</p></details>\n    <details><summary>Closed-loop performance</summary>\n      <div class=\"gs-control-grid\"><div v-for=\"(value, key) in msg.payload.closed_loop\" :key=\"key\"><span>{{ metricName(key) }}</span><strong>{{ value === null ? 'Not yet measurable' : typeof value==='number' ? fmt(value,Number.isInteger(value)?0:3) : value }}</strong></div></div>\n    </details>\n    <details><summary>Current charging assignments</summary>\n      <p v-for=\"a in msg.payload.decision.assignments\" :key=\"a.charger_id\">{{ a.charger_id }} → {{ a.ev_id }}: {{ fmt(a.rate_kw) }} kW</p>\n    </details>\n  </section><p v-else>Waiting for stored-data analytics...</p>\n</template>\n<script>\nexport default {\n  methods: {\n    fmt(v, digits=2) { return Number.isFinite(v) ? v.toFixed(digits) : '—' },\n    modelName(name) { return {traditional_decision_tree:'Decision Tree',ensemble_random_forest:'Random Forest',deep_ann:'Neural Network',traditional_svr:'Support Vector',ensemble_xgboost:'XGBoost',constant_baseline:'Constant baseline',untrained_safe_rules:'Deadline rules (untrained)'}[name] || name },\n    metricName(key) { const value=key.replace(/_/g,' ').replace(/\\bkw\\b/g,'kW').replace(/\\bkwh\\b/g,'kWh'); return value.charAt(0).toUpperCase()+value.slice(1) }\n  },\n  computed: { forecast() {\n    const d = this.msg?.payload?.decision;\n    return d?.model === 'untrained_safe_rules' ? 'Unavailable (untrained)' : this.fmt(d?.forecast_next_hour_kwh) + ' kWh';\n  } }\n}\n</script>\n<style>\n.gs-ml { padding: 16px; }\n.gs-ml table { width:100%; border-collapse:collapse; text-align:left; }\n.gs-ml th, .gs-ml td { padding:12px; border-bottom:1px solid #e2e8f0; white-space:nowrap; }\n.gs-ml th { background:#f3f7f5;color:#526b63;font-size:11px; }\n.gs-ml .selected { background:#dcfce7; color:#166534; }\n.gs-ml td { font-size:13px; }\n.gs-model-summary { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:24px 0; }\n.gs-model-summary>div { background:#f4f8f6;border:1px solid #e0eae4;padding:18px;border-radius:12px; }\n.gs-model-summary span,.gs-control-grid span { display:block;font-size:11px;color:#607571;margin-bottom:8px; }\n.gs-model-summary strong { font-size:18px;color:#184d3c; }.gs-model-summary small { font-size:12px; }\n.gs-model-winner { display:inline-block;font-size:9px;font-weight:700;letter-spacing:.8px;background:#bce8ca;color:#155c32;padding:4px 7px;border-radius:5px;margin-left:8px; }\n.gs-ml-note { color:#607571;font-size:12px;margin:16px 0; }\n.gs-ml details { border-top:1px solid #e4ece7;padding:16px 0;font-size:13px; }.gs-ml summary { cursor:pointer;font-weight:600;color:#355e4e; }.gs-ml details p { margin:12px 0 0;color:#607571; }\n.gs-control-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:20px;margin-top:20px; }\n@media(max-width:650px) { .gs-model-summary { grid-template-columns:1fr;gap:8px; }.gs-ml { padding:8px; }.gs-model-summary>div { padding:14px; } }\n</style>\n"
  },
  {
    "id": "base",
    "type": "ui-base",
    "name": "GridSense",
    "path": "/dashboard",
    "appIcon": "",
    "includeClientData": true,
    "acceptsClientConfig": [
      "ui-notification",
      "ui-control"
    ],
    "showPathInSidebar": false,
    "showPageTitle": true,
    "navigationStyle": "default",
    "titleBarStyle": "default"
  },
  {
    "id": "page",
    "type": "ui-page",
    "name": "Station overview",
    "ui": "base",
    "path": "/station",
    "icon": "electric-car",
    "layout": "grid",
    "theme": "theme",
    "breakpoints": [
      {
        "name": "Default",
        "px": "0",
        "cols": "3"
      },
      {
        "name": "Tablet",
        "px": "576",
        "cols": "6"
      },
      {
        "name": "Desktop",
        "px": "1024",
        "cols": "12"
      }
    ],
    "order": 1,
    "className": "gs-page",
    "visible": true,
    "disabled": false
  },
  {
    "id": "group",
    "type": "ui-group",
    "name": "Station overview",
    "page": "page",
    "width": "12",
    "height": "1",
    "order": 1,
    "showTitle": false,
    "className": "gs-section",
    "visible": true,
    "disabled": false,
    "groupType": "default"
  },
  {
    "id": "theme",
    "type": "ui-theme",
    "name": "GridSense",
    "colors": {
      "surface": "#ffffff",
      "primary": "#176b50",
      "bgPage": "#f1f6f3",
      "groupBg": "#ffffff",
      "groupOutline": "#dce7e4"
    },
    "sizes": {
      "density": "default",
      "pagePadding": "24px",
      "groupGap": "20px",
      "groupBorderRadius": "16px",
      "widgetGap": "16px"
    }
  },
  {
    "id": "live-filter",
    "type": "function",
    "z": "station",
    "name": "Path A: live telemetry only",
    "func": "return msg.payload.kind === 'history' ? null : msg;",
    "outputs": 1,
    "x": 390,
    "y": 40,
    "wires": [
      [
        "live-dashboard",
        "soc-router",
        "load-series",
        "price-history"
      ]
    ]
  },
  {
    "id": "live-dashboard",
    "type": "ui-template",
    "z": "station",
    "group": "group",
    "name": "Station overview and fleet",
    "order": 1,
    "width": "12",
    "height": "0",
    "templateScope": "local",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "x": 690,
    "y": 40,
    "wires": [
      []
    ],
    "format": "<template>\n  <section class=\"gs-overview\">\n    <header class=\"gs-hero\">\n      <div><p class=\"gs-eyebrow\">GRIDSENSE / ENERGY OPERATIONS</p>\n        <h1>Station overview</h1><p>Every vehicle. Every kilowatt. One clear view.</p>\n      </div>\n      <div class=\"gs-hero-status\">\n        <span :class=\"['gs-pill', fresh ? 'good' : 'waiting']\"><span aria-hidden=\"true\">●</span> {{ !state ? 'Awaiting telemetry' : fresh ? 'Telemetry live' : 'Telemetry stale' }}</span>\n        <span>Last sensor update · {{ lastSeen }}</span>\n        <span v-if=\"state\">Data: {{ state.source }} ? SoC is model-derived</span>\n        <span v-if=\"state\">Simulation · {{ simTime(state.hour) }}</span>\n      </div>\n    </header>\n\n    <div v-if=\"!state\" class=\"gs-empty\" role=\"status\"><h3>Ready when your station is</h3><p>Start the simulator to see charging sessions, grid load and electricity prices here.</p></div>\n    <template v-else>\n      <div v-if=\"!fresh\" class=\"gs-stale\" role=\"status\">Live updates have paused. Values below are the last received readings and may no longer reflect the station.</div>\n      <div class=\"gs-kpis\">\n        <article class=\"gs-kpi gs-load-card\"><p class=\"gs-label\">Grid load</p>\n          <svg class=\"gs-load-gauge\" viewBox=\"0 0 168 168\" role=\"img\" :aria-label=\"'Grid load: '+gauge.value+' kilowatts. '+gauge.label+'. Scale 0 to 10 kilowatts.'\">\n            <circle cx=\"84\" cy=\"84\" r=\"74\" fill=\"none\" stroke=\"#16a34a\" stroke-width=\"3\" pathLength=\"100\" stroke-dasharray=\"70 100\" transform=\"rotate(-90 84 84)\" />\n            <circle cx=\"84\" cy=\"84\" r=\"74\" fill=\"none\" stroke=\"#eab308\" stroke-width=\"3\" pathLength=\"100\" stroke-dasharray=\"25 100\" stroke-dashoffset=\"-70\" transform=\"rotate(-90 84 84)\" />\n            <circle cx=\"84\" cy=\"84\" r=\"74\" fill=\"none\" stroke=\"#dc2626\" stroke-width=\"3\" pathLength=\"100\" stroke-dasharray=\"5 100\" stroke-dashoffset=\"-95\" transform=\"rotate(-90 84 84)\" />\n            <circle cx=\"84\" cy=\"84\" r=\"60\" fill=\"none\" stroke=\"#e7eeeb\" stroke-width=\"12\" />\n            <circle v-if=\"gauge.percent>0\" class=\"gs-gauge-value\" cx=\"84\" cy=\"84\" r=\"60\" fill=\"none\" :stroke=\"gauge.color\" stroke-width=\"12\" pathLength=\"100\" :stroke-dasharray=\"gauge.percent+' 100'\" transform=\"rotate(-90 84 84)\" />\n            <text x=\"84\" y=\"82\" text-anchor=\"middle\" class=\"gs-gauge-number\" :fill=\"gauge.color\">{{ gauge.value }}</text>\n            <text x=\"84\" y=\"104\" text-anchor=\"middle\" class=\"gs-gauge-unit\">kW / 10 kW</text>\n          </svg>\n          <p class=\"gs-gauge-status\" :style=\"{color:gauge.color}\">{{ gauge.label }}</p>\n          <p class=\"gs-gauge-legend\"><span>🟢 &lt;7</span><span>🟡 7–9.5</span><span>🔴 &gt;9.5</span></p>\n          <p class=\"gs-muted\">{{ fmt(state.operating_limit_kw,1) }} kW operating limit <span v-if=\"overLimit\" class=\"gs-danger\">· Above limit</span></p>\n        </article>\n        <article class=\"gs-kpi\"><p class=\"gs-label\">Charging now</p><div class=\"gs-value\">{{ charging }} <small>/ {{ state.chargers?.length || 0 }} ports</small></div>\n          <p class=\"gs-muted\">{{ queued }} waiting · {{ completed }} complete</p></article>\n        <article class=\"gs-kpi\"><p class=\"gs-label\">Current tariff</p><div class=\"gs-value\">{{ fmt(state.price_per_kwh,0) }} <small>INR/kWh</small></div>\n          <p class=\"gs-muted\">{{ tariffLabel }} · simulated pricing</p></article>\n        <article class=\"gs-kpi\"><p class=\"gs-label\">Next departure</p><div class=\"gs-value gs-value-time\">{{ nextDeparture ? simTime(nextDeparture.departure) : '—' }}</div>\n          <p class=\"gs-muted\">{{ nextDeparture ? nextDeparture.id + ' · ' + fmt(nextDeparture.remaining_kwh) + ' kWh remaining' : 'No upcoming departures' }}</p></article>\n      </div>\n\n      <div class=\"gs-section-heading\"><div><p class=\"gs-eyebrow\">LIVE SESSIONS</p><h2>Your charging fleet</h2></div>\n        <label class=\"gs-search\"><span class=\"gs-sr-only\">Search vehicle ID</span><input v-model=\"search\" type=\"search\" placeholder=\"Search vehicle ID…\" /></label>\n      </div>\n      <div class=\"gs-filter-row\" aria-label=\"Filter charging sessions\">\n        <button v-for=\"item in filters\" :key=\"item.key\" type=\"button\" :aria-pressed=\"filter===item.key\" :class=\"{'is-active':filter===item.key}\" @click=\"filter=item.key\">{{ item.label }}</button>\n        <span class=\"gs-muted\">{{ visibleVehicles.length }} of {{ vehicles.length }} vehicles</span>\n      </div>\n      <div class=\"gs-fleet-head\" aria-hidden=\"true\"><span>Vehicle / status</span><span>Battery / target</span><span>Charging power</span><span>Departure</span><span>Energy needed</span></div>\n      <div v-for=\"ev in visibleVehicles\" :key=\"ev.id\" class=\"gs-fleet-row\">\n        <div class=\"gs-vehicle\"><span class=\"gs-vehicle-icon\" aria-hidden=\"true\">↯</span><div><strong>{{ ev.id }}</strong><span :class=\"['gs-status', ev.status]\">{{ statusLabel(ev.status) }}</span></div></div>\n        <div><span class=\"gs-mobile-label\">Battery / target</span><strong>{{ fmt(ev.soc*100,0) }}%</strong><span class=\"gs-muted\"> / {{ fmt(ev.target*100,0) }}%</span><div class=\"gs-battery\"><span :style=\"{width:Math.max(0,Math.min(100,ev.soc*100))+'%'}\"></span><i :style=\"{left:Math.max(0,Math.min(100,ev.target*100))+'%'}\" title=\"Target state of charge\"></i></div></div>\n        <div><span class=\"gs-mobile-label\">Charging power</span><strong>{{ fmt(ev.power_kw) }} kW</strong><small class=\"gs-muted gs-block\">{{ ev.charger || 'No port assigned' }}</small></div>\n        <div><span class=\"gs-mobile-label\">Departure</span><strong>{{ simTime(ev.departure) }}</strong><small class=\"gs-muted gs-block\">Simulation time</small></div>\n        <div><span class=\"gs-mobile-label\">Energy needed</span><strong>{{ fmt(ev.remaining_kwh) }} kWh</strong></div>\n      </div>\n      <div v-if=\"!visibleVehicles.length\" class=\"gs-empty\"><h3>No matching vehicles</h3><p>Try another vehicle ID or select All sessions.</p><button type=\"button\" class=\"gs-reset\" @click=\"filter='all';search=''\">Clear filters</button></div>\n      <p class=\"gs-footnote\">Synthetic station data · {{ state.capacity_kw }} kW physical rating · 5% capacity reserve</p>\n    </template>\n  </section>\n</template>\n<script>\nexport default {\n  data() { return {now:Date.now(),timer:null,search:'',filter:'all',filters:[{key:'all',label:'All sessions'},{key:'active',label:'On site'},{key:'queued',label:'Waiting'},{key:'complete',label:'Complete'},{key:'departed',label:'Departed'}]} },\n  mounted() { this.timer=setInterval(()=>{this.now=Date.now()},1000) },\n  unmounted() { clearInterval(this.timer) },\n  computed: {\n    state() { const p=this.msg?.payload; return Array.isArray(p?.vehicles) ? p : null },\n    vehicles() { return this.state?.vehicles || [] },\n    fresh() { const age=this.now-(this.state?.timestamp || 0)*1000; return !!this.state && age>=-5000 && age<10000 },\n    lastSeen() { return Number.isFinite(this.state?.timestamp) ? new Date(this.state.timestamp*1000).toLocaleTimeString() : 'Not received' },\n    charging() { return this.vehicles.filter(e=>e.status==='charging').length },\n    queued() { return this.vehicles.filter(e=>e.status==='queued').length },\n    completed() { return this.vehicles.filter(e=>e.status==='complete').length },\n    gauge() {\n      const kw=this.state?.load_kw;\n      if(!Number.isFinite(kw) || kw<0) return {value:'—',percent:0,color:'#64748b',label:'Reading unavailable'};\n      return {value:kw.toFixed(2),percent:Math.min(100,kw*10),\n        color:kw<7?'#16a34a':kw<=9.5?'#eab308':'#dc2626',\n        label:kw<7?'Normal load':kw<=9.5?'High load':kw<10?'Above operating limit':'At or above rated capacity'};\n    },\n    overLimit() { return this.state?.load_kw > this.state?.operating_limit_kw+1e-6 },\n    tariffLabel() { const p=this.state?.price_per_kwh; return !Number.isFinite(p)?'Tariff unavailable':p<=3?'Off-peak rate':p>=12?'Peak rate':'Standard rate' },\n    nextDeparture() { return this.vehicles.filter(e=>e.departure>this.state.hour && e.arrival<=this.state.hour && e.remaining_kwh>.01).sort((a,b)=>a.departure-b.departure)[0] },\n    visibleVehicles() { return this.vehicles.filter(e=>e.id.toLowerCase().includes(this.search.toLowerCase()) && (this.filter==='all' || (this.filter==='active' ? e.arrival<=this.state.hour && this.state.hour<e.departure : e.status===this.filter))) }\n  },\n  methods: {\n    fmt(value,digits=2) { return Number.isFinite(value)?value.toFixed(digits):'—' },\n    simTime(hour) { if(!Number.isFinite(hour)) return '—'; const minutes=Math.floor(hour*60+1e-6); const day=Math.floor(minutes/1440); return (day?'Day '+(day+1)+' · ':'')+String(Math.floor(minutes/60)%24).padStart(2,'0')+':'+String(minutes%60).padStart(2,'0') },\n    statusLabel(status) { return {scheduled:'Scheduled',queued:'Waiting',charging:'Charging',connected:'Connected',complete:'Target reached',departed:'Departed'}[status] || status }\n  }\n}\n</script>\n<style>\n.gs-page { color:#172b3a; font-family:Inter,'Segoe UI',sans-serif; }\n.gs-overview { padding:4px; }\n.gs-hero { display:flex;align-items:center;justify-content:space-between;gap:24px;padding:32px;border-radius:16px;background:linear-gradient(115deg,#102d35,#164f4b);color:#fff;margin-bottom:24px; }\n.gs-hero h1 { font-size:clamp(26px,4vw,36px);font-weight:650;letter-spacing:-1px;margin:8px 0;line-height:1.2; }\n.gs-hero p { color:#c5dedb;margin-bottom:0; }\n.gs-eyebrow { font-size:11px;font-weight:700;letter-spacing:1.8px;color:#55736d;margin:0 0 6px; }\n.gs-hero .gs-eyebrow { color:#99d9c6; }\n.gs-hero-status { display:flex;flex-direction:column;align-items:flex-end;gap:10px;font-size:12px;color:#c5dedb;white-space:nowrap; }\n.gs-pill { border-radius:100px;padding:7px 12px;font-size:12px;font-weight:650;display:inline-flex;gap:7px;align-items:center; }\n.gs-pill.good { background:#d1fae5;color:#065f46; }.gs-pill.waiting { background:#fef3c7;color:#854d0e; }\n.gs-kpis { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin:20px 0 32px; }\n.gs-kpi { padding:22px;background:#fff;border:1px solid #dce7e4;border-radius:14px;box-shadow:0 4px 16px #173c3205; }\n.gs-load-card { text-align:center; }.gs-load-card>.gs-label { text-align:left; }\n.gs-load-gauge { display:block;width:100%;max-width:168px;height:auto;margin:0 auto; }\n.gs-gauge-number { font:650 28px 'Segoe UI',sans-serif;letter-spacing:-1px; }.gs-gauge-unit { font:11px 'Segoe UI',sans-serif;fill:#607571; }\n.gs-gauge-status { font-size:12px;font-weight:650;margin:6px 0 8px; }\n.gs-gauge-legend { display:flex;justify-content:center;flex-wrap:wrap;gap:8px;font-size:10px;color:#526b68;margin:8px 0 12px; }\n.gs-label { color:#526b68;font-size:12px;font-weight:600;margin:0 0 12px; }\n.gs-value { font-size:32px;font-weight:650;letter-spacing:-1px;color:#123b35;line-height:1.3;margin-bottom:12px; }\n.gs-value small { font-size:12px;font-weight:500;letter-spacing:0;color:#526b68; }.gs-value-time { font-size:26px; }\n.gs-muted { color:#607571;font-size:12px; }.gs-kpi p:last-child { margin-bottom:0; }\n.gs-meter,.gs-battery { height:6px;border-radius:8px;background:#e7eeeb;position:relative;margin:12px 0; }\n.gs-meter span,.gs-battery span { display:block;height:100%;border-radius:8px;transition:width .35s;background:#10b981; }\n.gs-battery { max-width:140px;margin:8px 0 0; }.gs-battery i { position:absolute;top:-3px;height:12px;width:2px;background:#344b46; }\n.gs-section-heading { display:flex;align-items:center;justify-content:space-between;gap:16px;margin:20px 0; }\n.gs-section-heading h2 { font-size:22px;font-weight:650;letter-spacing:-.5px;margin:0; }\n.gs-search input { padding:10px 14px;border:1px solid #cddbd6;border-radius:10px;background:#fff;max-width:100%;font-size:13px;min-height:44px; }\n.gs-filter-row { display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:18px; }.gs-filter-row button,.gs-reset { padding:9px 13px;border:1px solid #dae5e0;border-radius:8px;color:#46615a;background:#fff;font-size:12px;font-weight:600;min-height:40px;cursor:pointer; }\n.gs-filter-row .is-active { background:#e0f2e9;border-color:#a0cdb7;color:#176345; }.gs-filter-row>.gs-muted { margin-left:auto; }\n.gs-page button:focus-visible,.gs-page input:focus-visible,.gs-page select:focus-visible,.gs-page summary:focus-visible { outline:3px solid #26826b;outline-offset:3px; }\n.gs-fleet-head,.gs-fleet-row { display:grid;grid-template-columns:1.3fr 1.1fr 1fr 1fr 1fr;gap:16px;align-items:center;padding:16px; }\n.gs-fleet-head { background:#f4f8f6;border-radius:8px;color:#58736b;font-size:11px;font-weight:600; }\n.gs-fleet-row { border-bottom:1px solid #e8efeb;min-height:88px;font-size:13px; }.gs-fleet-row:hover { background:#f8fbf9; }\n.gs-vehicle { display:flex;align-items:center;gap:12px; }.gs-vehicle-icon { display:grid;place-items:center;width:36px;height:40px;background:#e7f3ed;border-radius:10px;font-size:25px;color:#21765a; }\n.gs-status { display:block;font-size:11px;margin-top:3px;color:#607571; }.gs-status.charging,.gs-status.complete { color:#16734d; }.gs-status.queued { color:#93620c; }\n.gs-block { display:block;margin-top:4px; }.gs-mobile-label { display:none; }.gs-danger { color:#b91c1c; }\n.gs-footnote { font-size:11px;color:#71837d;margin:18px 0 4px; }.gs-stale { border:1px solid #ebd299;border-radius:10px;padding:12px 16px;background:#fff8e7;color:#80570b;font-size:13px; }\n.gs-empty { text-align:center;padding:48px 20px;color:#607571;background:#f7faf8;border:1px dashed #ccddd3;border-radius:12px; }.gs-empty h3 { color:#284c40;margin-bottom:8px; }.gs-empty p { margin-bottom:14px; }\n.gs-sr-only { position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }\n.gs-section { border:1px solid #dce7e4;box-shadow:0 4px 18px #173c3204; }\n@media(max-width:1100px) { .gs-kpis { grid-template-columns:repeat(2,minmax(0,1fr)); }.gs-hero { padding:24px; } }\n@media(max-width:650px) { .gs-hero { flex-direction:column;align-items:flex-start;gap:18px; }.gs-hero-status { align-items:flex-start; }.gs-kpis { gap:10px; }.gs-kpi { padding:16px; }.gs-value { font-size:26px; }.gs-value-time { font-size:20px; }.gs-section-heading { flex-direction:column;align-items:stretch; }.gs-search input { width:100%; }.gs-fleet-head { display:none; }.gs-fleet-row { grid-template-columns:1fr 1fr;border:1px solid #dce7e4;border-radius:12px;margin-bottom:12px;gap:18px; }.gs-vehicle { grid-column:1/-1; }.gs-mobile-label { display:block;font-size:10px;color:#607571;margin-bottom:4px; }.gs-filter-row>.gs-muted { width:100%;margin:0; }.gs-page { padding:0; } }\n@media(prefers-reduced-motion:reduce) { .gs-meter span,.gs-battery span { transition:none; } }\n</style>\n"
